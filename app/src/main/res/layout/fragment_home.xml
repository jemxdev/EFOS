<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Magandang Araw!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EFOS Dashboard"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginBottom="24dp"/>

        <!-- Big Scan Shortcut Button -->
        <Button
            android:id="@+id/btn_home_scan"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="START NEW SCAN"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- Live Farm Health Summary Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Device Statistics"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_home_total_scans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Total Scans Stored: 0"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tv_home_latest_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Latest Detection: None"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Visual Overall Health Meter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overall Crop Health Index"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ProgressBar
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                style="?android:attr/progressBarStyleHorizontal"
                android:progress="82"
                android:progressTint="#43A047"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="82% (Good)"
                android:textStyle="bold"
                android:textColor="#43A047"/>
        </LinearLayout>

        <!-- Health Recommendation Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#E3F2FD"> <!-- Light Blue Background -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩺 Health Recommendation"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your crop health is currently stable at 82%.\n\nAction: Maintain your current routine. Conduct visual inspections of the lower leaves every 3 days to catch any early signs of pests, and ensure consistent soil moisture."
                    android:textColor="#0D47A1"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tip of the Day -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#E8F5E9">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Field Tip"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practice a 3-4 year crop rotation away from other nightshades (tomatoes, peppers) to keep the soil healthy and pest-free."
                    android:textColor="#1B5E20"
                    android:textSize="14sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>