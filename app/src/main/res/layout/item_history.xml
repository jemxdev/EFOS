<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Thumbnail of scanned leaf -->
        <ImageView
            android:id="@+id/iv_history_thumb"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_phomopsis"
            android:contentDescription="Scanned Leaf Thumbnail" />

        <!-- Details Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_history_disease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phomopsis Blight"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tv_history_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="October 5, 2026 - 10:45 AM"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Severity Badge -->
        <TextView
            android:id="@+id/tv_history_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45% DSP"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:background="#FFEBEE"
            android:padding="6dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>